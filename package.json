{
  "name": "@modootoday/devtools-public-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter '*' build",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "release:check": "node tools/check-public-release.mjs"
  },
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=22.14.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/modootoday/devtools-public.git"
  }
}
